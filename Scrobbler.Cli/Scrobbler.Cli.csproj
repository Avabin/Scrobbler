<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>scrbl-cli</AssemblyName>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Tmds.DBus.Generator" Version="0.91.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.91.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrobbler.LastFm\Scrobbler.LastFm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="dbus-xml/org.scrobbler.Daemon.xml"
                     GenerateDBusTypes="true"
                     Namespace="Scrobbler.Cli.DBus" />
  </ItemGroup>

</Project>
